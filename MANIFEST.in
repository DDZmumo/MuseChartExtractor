include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include README.md
include ROADMAP.md
recursive-include docs *.md
recursive-include tools *.py
prune diagnostics
prune experimental
prune extracted
prune exports
prune MuseDashChartStore
prune payloads
global-exclude *.odin
global-exclude *.sqlite3
global-exclude store.json
global-exclude store_audit.json
global-exclude __pycache__
global-exclude *.py[cod]
